  "program": {
   "frequency": "유동적 — 주 2~4회. 세션 60분 이내",
   "primary_goal": "허리를 지키면서 컨디션·집중력 최적화. 동시에 '숫자가 오르는 재미'를 확보 — 성장 체감이 없으면 지속되지 않는 성향",
   "constraint": "제16회 변호사시험 2027-01-12. 학습 시간·수면 침해 금지",
   "back_safety_banned": [
    "바벨 백스쿼트 — 척추 직접 압박",
    "컨벤셔널·수모 데드리프트 — 최대 전단력",
    "바벨 벤트오버로우 — 굽힌 자세 유지 중 척추기립근 부하",
    "굿모닝·스티프레그 데드리프트",
    "스탠딩 바벨 오버헤드프레스 — 서서 하면 요추 신전 압박 (시티드 머신으로 대체)",
    "행잉 레그레이즈·싯업·크런치 — 반복적 요추 굴곡"
   ],
   "equipment_note": "[8/10~9/2 현재 구간] 신촌 헬스보이짐(프리미엄) — 체스트 서포티드 로우·인클라인 체스트프레스·펙덱 등 풀 장비 사용 가능(아래 제주 헬스장 제약 미적용). ▶ (9/3 제주 복귀 시) 본인 헬스장 실측: 체스트 서포티드 로우 없음 / 어덕션(모으기) 머신 있음, 어브덕션(벌리기) 머신 없음. 웬만한 헬스장에 다 있는 기구로만 구성 — 바벨·덤벨·케이블스테이션·랫풀다운·레그프레스·레그컬·레그익스텐션·시티드 체스트프레스·시티드 숄더프레스·펙덱·리어델트. ▶ (11/2 확인) 제주 헬스장에 힙 어브덕션(벌리기) 머신 있음 — 본인 88kg으로 실시. 위 '어브덕션 머신 없음'은 정정.",
   "principles": {
    "hard_floor": "주 2회는 어떤 상황에서도 사수 (슬럼프 컨틴전시 '절대사수')",
    "hard_ceiling": "주 4회·세션 60분 초과 금지",
    "rest_day_rule": "주 1회 무조건 휴식(영구원칙)일에는 운동도 완전 오프",
    "exam_week_rule": "모의고사·변시 주간은 자동 테이퍼 — 주 2회, RPE 6",
    "no_failure": "실패지점 금지. RIR 2~3 유지. 과도한 DOMS는 다음날 학습 집중을 직접 깎음",
    "double_progression": "반복수 범위 상단을 전 세트 달성하면 증량하고 반복수는 하단으로 리셋. 머신은 스택 단위가 커서 중량만으로는 성장 체감이 끊김 — 반복수부터 올리는 것이 정답",
    "no_percentage": "1RM 퍼센트 계산 금지. 항상 직전 실제 기록 기준. 과거 470kg은 참고값이 아니라 무관한 숫자",
    "machine_evidence": "머신 vs 프리웨이트는 근비대·근력 증가에서 유의한 차이가 없음(체계적 문헌고찰). 허리 이력이 있는 지금 머신 위주 선택에 성장 측면의 손해는 없습니다",
    "frequency_evidence": "주 2~3회 가능 시 '상/하체 2분할'이 아니라 '전신 A/B 2분할'이 정답. 근육군당 주 2회 자극이 주 1회보다 우월하다는 것이 메타분석 결론(Schoenfeld 2016·2019)인데, 상하체 분할은 주 2회 운동 시 각 근육이 주 1회밖에 자극받지 못한다. 전신 A/B는 주 2회여도 모든 근육이 주 2회, 주 3회면 주 3회 자극된다.",
    "cardio_evidence": "웨이트 후 유산소 20~30분·주 2~3회는 근력/근비대 간섭이 사실상 없다는 것이 최근 메타분석 결론. 다만 같은 세션에서 유산소를 '먼저' 하면 mTOR 억제로 간섭이 커지므로 반드시 웨이트 → 유산소 순서.",
    "stretch_rule": "스트레칭은 옵션이 아니라 세션의 마지막 종목으로 고정. 삭제해도 다음 세션에 다시 생성된다."
   }
